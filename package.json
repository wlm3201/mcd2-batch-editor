{
  "name": "mcd2-batch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Batch editor for Minecraft Dungeons II hero saves: edit one piece of gear, push its rolled effects onto every same-tag item.",
  "scripts": {
    "dev": "vite",
    "test": "node --test",
    "build:glossary": "node tools/build-glossary.mjs",
    "build:desktop": "node tools/build-app.mjs",
    "build:offline": "node tools/build-standalone.mjs",
    "build:pages": "node tools/build-pages.mjs",
    "build": "vite build",
    "start": "node server/index.js",
    "serve": "vite build && node server/index.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lossless-json": "^4.3.3",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "vite": "^8.3.5"
  }
}
